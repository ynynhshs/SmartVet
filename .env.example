PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_generated_secret
JWT_EXPIRES_IN=1h

# Web Push (browser notifications). Generate with: npx web-push generateVAPIDKeys
VAPID_SUBJECT=mailto:admin@smartvet.local
VAPID_PUBLIC_KEY=replace_with_public_key
VAPID_PRIVATE_KEY=replace_with_private_key